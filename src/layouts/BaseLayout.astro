---
import "../styles/global.css";
import { SITE } from "../lib/constants";
import { LOCALE_TAGS, type Locale } from "../lib/i18n";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  locale: Locale;
  title: string;
}
const { locale, title } = Astro.props;
---
<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {!SITE.indexable && <meta name="robots" content="noindex, nofollow" />}

    {/* Self-hosted, so no third-party font request. latin-ext is not an
        optimisation: it carries the Maori macrons and German umlauts. */}
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-dvh">
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />

    <script is:inline>
      (function () {
        var staged = document.querySelectorAll("[data-reveal]");
        if (!staged.length) return;

        var reduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Reduced motion, or no IntersectionObserver: everything is simply
        // present. Content must never depend on an effect having run.
        if (reduced || !("IntersectionObserver" in window)) {
          staged.forEach(function (el) { el.setAttribute("data-revealed", "true"); });
          return;
        }

        staged.forEach(function (el) { el.setAttribute("data-revealed", "false"); });

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.setAttribute("data-revealed", "true");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );
        staged.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
