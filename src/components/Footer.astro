---
import { SITE, SOCIAL } from "../lib/constants";
import { byRank } from "../lib/catalog";
import { tourCopy } from "../lib/i18n/dictionary";
import { footerGroup } from "../lib/nav";

const year = new Date().getFullYear();
const top = byRank().slice(0, 5);
---
<footer class="surface-dream border-t border-[var(--color-ground-line)]">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-lg font-semibold">
          Slow<span class="text-[var(--color-sulphur)]">North</span>
        </p>
        <p class="mt-3 max-w-xs text-sm text-[var(--text-muted)]">{SITE.tagline}</p>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-[var(--color-sulphur)] uppercase">Tours</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {top.map((tr) => (
            <li>
              <a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]"
                 href={`/tours/${tr.id}`}>{tourCopy("en", tr.id).name}</a>
            </li>
          ))}
          <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href="/tours">All tours and prices</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-[var(--color-sulphur)] uppercase">This site</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {footerGroup("legal").map((r) => (
            <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href={r.href}>{r.label}</a></li>
          ))}
          {footerGroup("company").map((r) => (
            <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href={r.href}>{r.label}</a></li>
          ))}
          {/* GDPR: withdrawing consent must be as easy as giving it. */}
          <li>
            <button type="button" data-consent-open
                    class="text-left text-[var(--text-muted)] underline underline-offset-2 transition hover:text-[var(--color-lake)]">
              Cookie preferences
            </button>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-[var(--color-sulphur)] uppercase">Follow along</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {SOCIAL.map((s) => (
            <li>
              <a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]"
                 href={s.href} rel="me noopener noreferrer" target="_blank">{s.label}</a>
            </li>
          ))}
        </ul>

        <h2 class="mt-6 text-xs font-semibold tracking-[0.14em] text-[var(--color-sulphur)] uppercase">Where we are</h2>
        <p class="mt-4 text-sm text-[var(--text-muted)]">
          Based in {SITE.base}, working across the North Island.
        </p>
      </div>
    </div>

    {/* The repo is public and the operator is invented. Saying so on every page
        is the minimum honest disclosure, and it is why this can be public at all. */}
    <p class="mt-12 rounded-[var(--radius-card)] border border-[var(--color-sulphur)]/30 bg-[var(--color-sulphur)]/[0.07] p-4 text-sm text-[var(--text-muted)]">
      <strong class="text-[var(--color-sulphur)]">Please note.</strong>
      This is a demonstration website for a company that does not exist. Nothing on it
      can be booked, and no price here is a real offer.
    </p>

    <p class="mt-8 border-t border-[var(--color-ground-line)] pt-8 text-xs text-[var(--text-muted)]">
      © {year} {SITE.name}.
    </p>
  </div>
</footer>
