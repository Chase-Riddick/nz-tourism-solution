---
import { SITE, CONTACT, SOCIAL } from "../lib/constants";
import { t } from "../lib/i18n/dictionary";
import { localePath, type Locale } from "../lib/i18n";
import { byRank } from "../lib/catalog";
import { tourCopy } from "../lib/i18n/dictionary";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const year = new Date().getFullYear();
const top = byRank().slice(0, 5);
---

<footer class="surface-dream border-t border-[var(--color-ground-line)]">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-lg font-semibold">
          Slow<span class="text-[var(--color-sulphur)]">North</span>
        </p>
        <p class="mt-3 max-w-xs text-sm text-[var(--text-muted)]">{d.footer.tagline}</p>
        <p class="mt-4 text-sm text-[var(--text-muted)]">{d.footer.builtIn}</p>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-[var(--color-sulphur)] uppercase">{d.footer.exploreTitle}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {top.map((tr) => (
            <li>
              <a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]"
                 href={localePath(locale, `tours/${tr.id}`)}>{tourCopy(locale, tr.id).name}</a>
            </li>
          ))}
          <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href={localePath(locale, "tours")}>{d.ui.backToTours}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-[var(--color-sulphur)] uppercase">{d.footer.companyTitle}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href={localePath(locale, "about")}>{d.nav.about}</a></li>
          <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href={localePath(locale, "safety")}>{d.nav.safety}</a></li>
          <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href={localePath(locale, "destinations")}>{d.nav.destinations}</a></li>
          <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href={localePath(locale, "faq")}>{d.nav.faq}</a></li>
          <li><a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]" href={localePath(locale, "contact")}>{d.nav.contact}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-[var(--color-sulphur)] uppercase">{d.footer.followTitle}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {SOCIAL.filter((s) => s.primary).map((s) => (
            <li>
              <a class="text-[var(--text-muted)] transition hover:text-[var(--color-lake)]"
                 href={s.href} rel="me noopener noreferrer" target="_blank">{s.label}</a>
            </li>
          ))}
        </ul>
        <h2 class="mt-6 text-xs font-semibold tracking-[0.14em] text-[var(--color-sulphur)] uppercase">{d.nav.contact}</h2>
        <ul class="mt-4 space-y-2 text-sm text-[var(--text-muted)]">
          <li><a class="transition hover:text-[var(--color-lake)]" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li>{CONTACT.hours}</li>
        </ul>
      </div>
    </div>

    {/* The site is a demonstration. Saying so in the footer of every page is the
        minimum honest disclosure, and it is why the repo can be public. */}
    <p class="mt-12 rounded-[var(--radius-card)] border border-[var(--color-sulphur)]/30 bg-[var(--color-sulphur)]/[0.07] p-4 text-sm text-[var(--text-muted)]">
      <strong class="text-[var(--color-sulphur)]">Please note.</strong> {d.footer.fictionNotice}
    </p>

    <div class="mt-8 flex flex-col gap-4 border-t border-[var(--color-ground-line)] pt-8 text-xs text-[var(--text-muted)] md:flex-row md:items-center md:justify-between">
      <p>© {year} {SITE.legalName}. {d.footer.rights}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a class="transition hover:text-[var(--color-lake)]" href={localePath(locale, "privacy")}>{d.footer.privacy}</a></li>
        <li><a class="transition hover:text-[var(--color-lake)]" href={localePath(locale, "terms")}>{d.footer.terms}</a></li>
        <li><a class="transition hover:text-[var(--color-lake)]" href={localePath(locale, "cookies")}>{d.footer.cookies}</a></li>
        <li><a class="transition hover:text-[var(--color-lake)]" href={localePath(locale, "credits")}>{d.footer.credits}</a></li>
        <li><a class="transition hover:text-[var(--color-lake)]" href={localePath(locale, "accessibility")}>{d.footer.accessibility}</a></li>
        <li><button type="button" data-consent-open class="underline underline-offset-2 transition hover:text-[var(--color-lake)]">{d.consent.manage}</button></li>
      </ul>
    </div>
  </div>
</footer>
