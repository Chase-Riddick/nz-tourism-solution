---
import { SITE, OG_IMAGE } from "../lib/constants";
import { alternates, LOCALE_TAGS, type Locale } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Locale-less logical path, e.g. "tours/east-cape-five". Drives hreflang. */
  path: string;
  image?: string;
  type?: "website" | "article";
}

const { title, description, locale, path, image, type = "website" } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image ?? OG_IMAGE.path, SITE.url).href;
const alts = alternates(path);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/*
  AGENTS.md rule 4. This site describes a tour operator that does not exist, at
  researched-but-invented prices, with a booking flow that looks real. A person
  searching for a North Island tour must never land here. This is an ethics
  rule, not an SEO setting — see docs/adr/0001.
*/}
{!SITE.indexable && <meta name="robots" content="noindex, nofollow, noarchive" />}

{SITE.indexable && alts.map((a) => (
  <link rel="alternate" hreflang={a.tag} href={new URL(a.href, SITE.url).href} />
))}
{SITE.indexable && (
  <link rel="alternate" hreflang="x-default" href={new URL(alts[0].href, SITE.url).href} />
)}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={LOCALE_TAGS[locale].replace("-", "_")} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:alt" content={OG_IMAGE.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
