---
interface Props { items: Array<{ q: string; a: string }>; title?: string }
const { items, title } = Astro.props;
---
{title && <h2 class="font-display mb-6 text-2xl font-semibold">{title}</h2>}
<div class="divide-y divide-[var(--surface-line)] border-y border-[var(--surface-line)]">
  {items.map((item) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-medium">
        <span>{item.q}</span>
        <svg class="mt-1 shrink-0 transition group-open:rotate-45" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="prose-measure mt-3 text-[var(--text-muted)]" set:html={item.a} />
    </details>
  ))}
</div>
