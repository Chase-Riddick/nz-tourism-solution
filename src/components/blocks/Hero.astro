---
import Photo from "../Photo.astro";

interface Props {
  image: string;
  alt: string;
  kicker?: string;
  title: string;
  body?: string;
  /** full = 100dvh-ish landing hero; page = shorter banner for inner pages. */
  size?: "full" | "page";
}
const { image, alt, kicker, title, body, size = "page" } = Astro.props;
const h = size === "full" ? "min-h-[88svh]" : "min-h-[52svh]";
---
<section class={`surface-dream relative isolate flex ${h} items-end overflow-hidden`}>
  <Photo id={image} alt={alt} priority sizes="100vw" data-hero-image
         class="absolute inset-0 -z-10 h-full w-full object-cover" />
  {/* The scrim is what lets a merely-good photograph carry a hero band: behind a
      gradient wash and a headline it stops being a photo you evaluate. */}
  <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page w-full pt-32 pb-14 md:pb-20">
    {kicker && (
      <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-[var(--color-sulphur)] uppercase">{kicker}</p>
    )}
    <h1 class={`font-display font-semibold text-balance text-[var(--color-ink-on-dark)] ${
      size === "full" ? "text-5xl leading-[1.02] sm:text-6xl lg:text-7xl" : "text-4xl leading-tight sm:text-5xl"
    }`}>{title}</h1>
    {body && <p class="prose-measure mt-5 text-lg text-[var(--color-ink-on-dark)]/85">{body}</p>}
    <div class="mt-8"><slot /></div>
  </div>
</section>
