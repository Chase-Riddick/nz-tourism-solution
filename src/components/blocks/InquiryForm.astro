---
/**
 * Enquiry form. Presentation mode when BOOKING.contactEndpoint is unset —
 * real UI, graceful static success state, no endpoint.
 *
 * Bot defence is a honeypot plus (when an endpoint is chosen) that service's
 * own captcha. Deliberately no time-trap: a "submitted too fast = bot" rule
 * silently drops real leads on a false positive, and one lost enquiry costs
 * more than deleting junk.
 */
import { BOOKING, CONTACT } from "../../lib/constants";
import { TOURS } from "../../lib/catalog";
import { tourCopy } from "../../lib/i18n/dictionary";

const COPY = {
  formName: "Your name",
  formEmail: "Email",
  formPhone: "Phone or WhatsApp (optional)",
  formTour: "Which tour?",
  formTourAny: "Not sure yet",
  formDates: "Rough dates",
  formGroup: "How many of you?",
  formMessage: "Anything else we should know?",
  formSubmit: "Send it",
  formSuccess: "Thanks — that's come through.",
  formSuccessBody: "We'll reply to the address you gave us, usually within one working day.",
  formPresentation: "This form is a demonstration and is not connected to an inbox yet.",
  responseNote: "We answer enquiries Monday to Saturday, New Zealand time.",
} as const;

interface Props { preselect?: string }
const { preselect } = Astro.props;
const live = Boolean(BOOKING.contactEndpoint);
const field = "w-full rounded-lg border border-[var(--surface-line)] bg-[var(--surface-raised)] px-4 py-3 text-[var(--text)] outline-none focus:border-[var(--interactive)]";
const label = "block text-sm font-medium mb-1.5";
---
<form
  id="inquiry"
  class="space-y-5"
  method={live ? "POST" : undefined}
  action={live ? BOOKING.contactEndpoint! : undefined}
  data-inquiry-form
  data-live={live ? "true" : "false"}
>
  {!live && (
    <p class="rounded-lg border border-[var(--color-sulphur)]/40 bg-[var(--color-sulphur)]/10 px-4 py-3 text-sm">
      {COPY.formPresentation}
    </p>
  )}

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label} for="f-name">{COPY.formName}</label>
      <input class={field} id="f-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div>
      <label class={label} for="f-email">{COPY.formEmail}</label>
      <input class={field} id="f-email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label} for="f-phone">{COPY.formPhone}</label>
      <input class={field} id="f-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
    <div>
      <label class={label} for="f-group">{COPY.formGroup}</label>
      <input class={field} id="f-group" name="group" type="number" min="1" max="8" />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label} for="f-tour">{COPY.formTour}</label>
      <select class={field} id="f-tour" name="tour">
        <option value="">{COPY.formTourAny}</option>
        {TOURS.map((tr) => (
          <option value={tr.id} selected={tr.id === preselect}>{tourCopy("en", tr.id).name}</option>
        ))}
      </select>
    </div>
    <div>
      <label class={label} for="f-dates">{COPY.formDates}</label>
      <input class={field} id="f-dates" name="dates" type="text" placeholder="e.g. March 2027" />
    </div>
  </div>

  <div>
    <label class={label} for="f-message">{COPY.formMessage}</label>
    <textarea class={field} id="f-message" name="message" rows="5"></textarea>
  </div>

  {/* Honeypot. Off-screen rather than display:none — some bots skip
      display-hidden fields. aria-hidden + tabindex keep it away from screen
      readers and keyboard users; the name is one no password manager fills. */}
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for="f-gotcha">Leave this empty</label>
    <input id="f-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit"
          class="rounded-full bg-[var(--color-sulphur)] px-7 py-3.5 font-semibold text-[var(--color-ground-deep)] transition hover:bg-[var(--color-sulphur-bright)]">
    {COPY.formSubmit}
  </button>

  <p class="text-sm text-[var(--text-muted)]">{COPY.responseNote}</p>
</form>

<div id="inquiry-success" hidden class="rounded-[var(--radius-card)] border border-[var(--interactive)]/40 bg-[var(--interactive)]/10 p-6">
  <p class="font-display text-xl font-semibold">{COPY.formSuccess}</p>
  <p class="mt-2 text-[var(--text-muted)]">{COPY.formSuccessBody}</p>
  {/* Address read-back: catches the one thing double opt-in would have caught
      (a typo'd address) without any of its backscatter risk. */}
  <p class="mt-3 text-sm text-[var(--text-muted)]">
    <span data-readback-label>—</span> <strong data-readback class="text-[var(--text)]"></strong>
  </p>
  <p class="mt-4 text-sm text-[var(--text-muted)]">{CONTACT.email}</p>
</div>

<script is:inline>
  (function () {
    const form = document.querySelector("[data-inquiry-form]");
    const ok = document.getElementById("inquiry-success");
    if (!form || !ok) return;
    form.addEventListener("submit", function (e) {
      const honey = form.querySelector('[name="_gotcha"]');
      // A bot told it failed simply retries, so show success either way.
      if (honey && honey.value) { e.preventDefault(); form.hidden = true; ok.hidden = false; return; }
      if (form.getAttribute("data-live") === "true") return;   // real POST
      e.preventDefault();
      const email = form.querySelector('[name="email"]');
      const rb = ok.querySelector("[data-readback]");
      if (rb && email) rb.textContent = email.value;
      form.hidden = true;
      ok.hidden = false;
      ok.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  })();
</script>
