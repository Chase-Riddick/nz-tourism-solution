---
/**
 * Shared shell for the policy pages. They are read, not browsed, so they get
 * the work surface, a single measure, and no photography competing for
 * attention.
 */
interface Props { title: string; lede?: string; updated?: string }
const { title, lede, updated = "18 August 2026" } = Astro.props;
---
<section class="surface-work pt-32 pb-20">
  <div class="container-page">
    <div class="prose-measure">
      <h1 class="font-display text-4xl font-semibold sm:text-5xl">{title}</h1>
      {lede && <p class="mt-4 text-lg text-[var(--text-muted)]">{lede}</p>}
      <p class="mt-3 text-sm text-[var(--text-muted)]">Last updated {updated}</p>
      <div class="mt-10 space-y-6 leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .prose-measure h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    margin-top: 2.5rem;
  }
  .prose-measure h2 + p { margin-top: 0.75rem; }
  .prose-measure ul { list-style: disc; padding-left: 1.25rem; }
  .prose-measure li { margin-top: 0.4rem; }
  .prose-measure a { text-decoration: underline; text-underline-offset: 2px; }
</style>
