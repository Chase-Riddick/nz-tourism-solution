---
import BaseLayout from "../layouts/BaseLayout.astro";
import InquiryForm from "../components/blocks/InquiryForm.astro";
import { CONTACT, MAX_GROUP } from "../lib/constants";
---
<BaseLayout locale="en" title="Contact — Slow North">
  <section class="surface-work py-20">
    <div class="container-page">
      <h1 class="font-display text-4xl font-semibold sm:text-5xl">Get in touch</h1>
      <p class="prose-measure mt-4 text-lg text-[var(--text-muted)]">
        We are a small team, so you will get a person rather than a ticketing system.
        Tell us roughly what you are after and we will come back {CONTACT.responseTime}.
      </p>

      <div class="mt-12 grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
        <div class="max-w-2xl">
          <InquiryForm />
        </div>
        <aside class="rounded-[var(--radius-card)] border border-[var(--surface-line)] p-6">
          <h2 class="font-display text-lg font-semibold">Other ways to reach us</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="text-[var(--text-muted)]">Email</dt>
              <dd><a class="underline underline-offset-2" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
            </div>
            <div>
              <dt class="text-[var(--text-muted)]">Phone</dt>
              <dd>{CONTACT.phone.display}</dd>
            </div>
            <div>
              <dt class="text-[var(--text-muted)]">Hours</dt>
              <dd>{CONTACT.hours}</dd>
            </div>
            <div>
              <dt class="text-[var(--text-muted)]">Group size</dt>
              <dd>Maximum {MAX_GROUP} guests on any departure</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
