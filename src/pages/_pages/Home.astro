---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/blocks/Hero.astro";
import Section from "../../components/blocks/Section.astro";
import TourCard from "../../components/blocks/TourCard.astro";
import CtaBand from "../../components/blocks/CtaBand.astro";
import Photo from "../../components/Photo.astro";
import { t } from "../../lib/i18n/dictionary";
import { localePath, type Locale } from "../../lib/i18n";
import { byRank, nzd, TOURS } from "../../lib/catalog";
import { SEASONS, MAX_GROUP, CREDENTIALS, SITE } from "../../lib/constants";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const featured = byRank().slice(0, 6);
const cheapest = Math.min(...TOURS.map((x) => x.price));
---
<BaseLayout locale={locale} title={d.home.metaTitle} description={d.home.metaDescription} path="">
  <Hero
    size="full"
    image="tongariro-01"
    alt="Red Crater on the Tongariro Alpine Crossing, with Mount Ngāuruhoe rising above cloud"
    kicker={d.home.heroKicker}
    title={d.home.heroTitle}
    body={d.home.heroBody}
  >
    <div class="flex flex-wrap gap-4">
      <a href={localePath(locale, "tours")}
         class="rounded-full bg-[var(--color-sulphur)] px-7 py-3.5 font-semibold text-[var(--color-ground-deep)] transition hover:bg-[var(--color-sulphur-bright)]">
        {d.home.heroCtaPrimary}
      </a>
      <a href="#why"
         class="rounded-full border border-white/25 px-7 py-3.5 font-semibold text-[var(--color-ink-on-dark)] transition hover:border-[var(--color-lake)] hover:text-[var(--color-lake)]">
        {d.home.heroCtaSecondary}
      </a>
    </div>
  </Hero>

  {/* WORK surface: the argument for the price, made in plain reading conditions. */}
  <Section id="why" surface="work" kicker={d.home.introKicker} title={d.home.introTitle}>
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-start">
      <div class="prose-measure space-y-5 text-lg leading-relaxed">
        {d.home.introBody.split("\n\n").map((p) => <p>{p}</p>)}
      </div>
      <Photo id="east-cape-04" alt="An empty road along the East Cape with a single wind-shaped tree"
             sizes="(min-width:1024px) 45vw, 90vw"
             class="aspect-[4/3] overflow-hidden rounded-[var(--radius-card)]" />
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3">
      {d.home.pillars.map((p, i) => (
        <div class="border-t-2 border-[var(--accent)] pt-5">
          <p class="font-display text-sm font-semibold text-[var(--accent)]">0{i + 1}</p>
          <h3 class="font-display mt-2 text-xl font-semibold">{p.title}</h3>
          <p class="mt-3 text-[var(--text-muted)]">{p.body}</p>
        </div>
      ))}
    </div>
  </Section>

  {/* DREAM surface: browsing. */}
  <Section kicker={d.nav.tours} title={d.home.toursTitle} lede={d.home.toursBody}>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((tour) => <TourCard tour={tour} locale={locale} />)}
    </div>
    <div class="mt-10">
      <a href={localePath(locale, "tours")}
         class="inline-block rounded-full border border-white/20 px-6 py-3 font-semibold transition hover:border-[var(--color-lake)] hover:text-[var(--color-lake)]">
        {d.home.toursCta} →
      </a>
    </div>
  </Section>

  {/* Seasons. The single most credibility-critical block on the site: a
      northern-hemisphere reader assumes July is summer, and a New Zealander
      spots the error instantly. */}
  <Section surface="work" kicker={d.ui.season} title={d.home.seasonTitle} lede={d.home.seasonBody}>
    <div class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[var(--surface-line)] bg-[var(--surface-line)] md:grid-cols-4">
      {SEASONS.map((s) => (
        <div class="bg-[var(--surface-raised)] p-6">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="font-display text-xl font-semibold">{s.label}</h3>
            <span class={`rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-wide uppercase ${
              s.pricing === "peak" ? "bg-[var(--color-sulphur)]/20 text-[var(--accent)]"
              : s.pricing === "low" ? "bg-[var(--color-lake-deep)]/15 text-[var(--interactive)]"
              : "bg-black/5 text-[var(--text-muted)]"
            }`}>{s.pricing}</span>
          </div>
          <p class="mt-1 text-sm font-medium text-[var(--text-muted)]">{s.months}</p>
          <p class="mt-1 text-sm text-[var(--text-muted)]">{s.temp}</p>
          <p class="mt-4 text-sm">{s.note}</p>
        </div>
      ))}
    </div>
    <div class="mt-8">
      <a href={localePath(locale, "destinations")} class="font-semibold text-[var(--interactive)] underline underline-offset-4">
        {d.home.seasonCta} →
      </a>
    </div>
  </Section>

  {/* Proof. A small operator earns trust by being specific. */}
  <Section kicker={d.nav.safety} title={d.home.proofTitle} lede={d.home.proofBody}>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {[
        { k: MAX_GROUP.toString(), v: d.ui.maxGroup },
        { k: `${nzd(cheapest)}`, v: d.ui.from + " · " + d.ui.perPerson },
        { k: "1–5", v: d.ui.days },
        { k: "100%", v: d.ui.gstIncluded },
      ].map((s) => (
        <div class="rounded-[var(--radius-card)] border border-[var(--surface-line)] bg-[var(--surface-raised)] p-6">
          <p class="font-display text-4xl font-semibold text-[var(--accent)]">{s.k}</p>
          <p class="mt-2 text-sm text-[var(--text-muted)]">{s.v}</p>
        </div>
      ))}
    </div>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2">
      {CREDENTIALS.slice(0, 6).map((c) => (
        <li class="flex items-start gap-3 rounded-lg border border-[var(--surface-line)] p-4">
          <span class={`mt-1.5 size-2 shrink-0 rounded-full ${c.status === "pending" ? "bg-[var(--color-lake)]" : "bg-[var(--color-sulphur)]"}`}></span>
          <div>
            <p class="text-sm font-medium">{c.label}</p>
            <p class="mt-0.5 text-sm text-[var(--text-muted)]">{c.note}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-6">
      <a href={localePath(locale, "safety")} class="font-semibold text-[var(--interactive)] underline underline-offset-4">
        {d.nav.safety} →
      </a>
    </p>
  </Section>

  <CtaBand locale={locale} />
</BaseLayout>
