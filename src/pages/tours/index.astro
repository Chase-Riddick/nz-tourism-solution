---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourCard from "../../components/blocks/TourCard.astro";
import { dayTours, multiDayTours, toursInSeason } from "../../lib/catalog";
import { SEASONS } from "../../lib/constants";
import { tourCopy } from "../../lib/i18n/dictionary";
import { MAX_GROUP } from "../../lib/constants";
---
<BaseLayout locale="en" title="Tours and prices — Slow North"
  description="Every North Island tour we run, with prices in NZD, what is included, and the months each one operates.">
  <section class="surface-work py-20">
    <div class="container-page">
      <h1 class="font-display text-4xl font-semibold sm:text-5xl">Tours and prices</h1>
      <p class="prose-measure mt-4 text-lg text-[var(--text-muted)]">
        Ten tours, one to five days. Every price is per person, in New Zealand dollars,
        GST included. Multi-day prices are twin share, maximum {MAX_GROUP} guests.
      </p>

      {/* Day tours return to base nightly, so they can run almost daily.
          Multi-day tours carry accommodation, so departures are set. That is a
          real operational difference, not a presentational one. */}
      <section data-group="day" class="mt-16">
        <h2 class="font-display text-2xl font-semibold">Day tours</h2>
        <p class="mt-2 text-[var(--text-muted)]">Back where you started by evening.</p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {dayTours().map((tour) => <TourCard tour={tour} />)}
        </div>
      </section>

      <section data-group="multi" class="mt-20">
        <h2 class="font-display text-2xl font-semibold">Two to five days</h2>
        <p class="mt-2 text-[var(--text-muted)]">
          Accommodation and breakfast included, twin share. Departures are set rather
          than daily — one vehicle and one guide only stretches so far.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {multiDayTours().map((tour) => <TourCard tour={tour} />)}
        </div>
      </section>

      {/* The product rotates with the season rather than the calendar simply
          repeating. Showing winter with the alpine tours absent - and something
          still running - is the honest version of "tours across the year". */}
      <section class="mt-24">
        <h2 class="font-display text-2xl font-semibold">What runs when</h2>
        <p class="prose-measure mt-2 text-[var(--text-muted)]">
          New Zealand's seasons run opposite to the northern hemisphere. There is no
          real ski season on the North Island, so we do not close — we move.
        </p>

        <div class="mt-8 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[var(--surface-line)] bg-[var(--surface-line)] md:grid-cols-4">
          {SEASONS.map((s) => (
            <div data-season-key={s.key} class="bg-[var(--surface-raised)] p-5">
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-display text-lg font-semibold">{s.label}</h3>
                <span class="rounded-full bg-black/5 px-2 py-0.5 text-[10px] font-semibold tracking-wide uppercase">
                  {s.pricing}
                </span>
              </div>
              <p class="mt-1 text-sm font-medium text-[var(--text-muted)]">{s.months}</p>
              <p class="mt-1 text-sm text-[var(--text-muted)]">{s.temp}</p>
              <p class="mt-3 text-sm">{s.note}</p>
              <ul class="mt-4 space-y-1.5 border-t border-[var(--surface-line)] pt-3 text-sm">
                {toursInSeason(s.key).map((tr) => (
                  <li data-season-tour>
                    <a class="underline-offset-2 hover:underline" href={`/tours/${tr.id}`}>
                      {tourCopy("en", tr.id).name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
